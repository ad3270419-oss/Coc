<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (always dark to match #0f172a -> #1e1b4b app gradient). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0f172a</item>
        <item name="colorPrimaryDark">#0f172a</item>
        <item name="colorAccent">#fbbf24</item>
        <item name="android:windowBackground">#0f172a</item>
        <item name="android:colorBackground">#0f172a</item>
        <item name="android:statusBarColor">#0f172a</item>
        <item name="android:navigationBarColor">#1e1b4b</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#0f172a</item>
        <item name="android:colorBackground">#0f172a</item>
        <item name="android:statusBarColor">#0f172a</item>
        <item name="android:navigationBarColor">#1e1b4b</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>